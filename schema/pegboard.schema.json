{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rmandevs/pegboard/main/schema/pegboard.schema.json",
  "title": "pegboard.yaml",
  "description": "Desired state of MCPs, skills, and context for agents (SPEC §3.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "agents": {
      "description": "Targets to configure. Default: detected agents.",
      "type": "array",
      "items": { "$ref": "#/$defs/agentRef" },
      "uniqueItems": true
    },
    "inherit": {
      "description": "Project stacks only: whether to inherit the global stack.",
      "enum": ["global", "none"]
    },
    "include": {
      "description": "Remote stacks merged in order, before this file.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mcps": {
      "description": "MCP servers by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/mcp" }
    },
    "skills": {
      "description": "Skills: owner/name, git URL (host/repo//path?ref=x), or local path (./…).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents_md": {
          "description": "Guarantees AGENTS.md and the @AGENTS.md bridge in CLAUDE.md.",
          "type": "boolean"
        }
      }
    },
    "remove": {
      "description": "Removes inherited or included resources; applied at the end of the merge.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcps": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "policy": {
      "description": "Validations plan/apply run on the merge result (SPEC §8).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_mcps": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "agentRef": {
      "description": "Agent ID, optionally with a profile: hermes:work.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(:[A-Za-z0-9][A-Za-z0-9_.-]*)?$"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "url": { "type": "string", "pattern": "^https?://" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "agents": {
          "description": "Restricts the MCP to these agents.",
          "type": "array",
          "items": { "$ref": "#/$defs/agentRef" },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "title": "stdio",
          "required": ["command"],
          "not": { "anyOf": [{ "required": ["url"] }, { "required": ["headers"] }] }
        },
        {
          "title": "http",
          "required": ["url"],
          "not": { "anyOf": [{ "required": ["command"] }, { "required": ["args"] }, { "required": ["env"] }] }
        }
      ]
    }
  }
}
